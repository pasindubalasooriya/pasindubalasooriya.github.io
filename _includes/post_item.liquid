{% if post.read_time %}
  {% assign read_time = post.read_time %}
{% else %}
  {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
{% endif %}
{% if post.redirect == blank %}
  {% assign post_link = post.url | relative_url %}
  {% assign post_external = false %}
{% elsif post.redirect contains '://' %}
  {% assign post_link = post.redirect %}
  {% assign post_external = true %}
{% else %}
  {% assign post_link = post.redirect | relative_url %}
  {% assign post_external = false %}
{% endif %}
<article
  class="entry{% if post.thumbnail %} entry-with-thumb{% endif %}"
  data-search="{{ post.title | downcase | escape }} {{ post.description | downcase | escape }} {{ post.tags | join: ' ' | downcase | escape }}"
>
  {% if post.thumbnail %}
    <a
      class="entry-thumb"
      href="{{ post_link }}"
      tabindex="-1"
      aria-hidden="true"
      {% if post_external %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      <img src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
  <div class="entry-body">
    <div class="entry-head">
      <a
        class="entry-title"
        href="{{ post_link }}"
        {% if post_external %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- post.title -}}
      </a>
      <span class="entry-date">{{ post.date | date: '%b' }}</span>
    </div>
    {% if post.description %}
      <p class="entry-desc">{{ post.description }}</p>
    {% endif %}
    <div class="entry-meta">
      {% if post.categories.size > 0 %}
        <span class="entry-category">{{ post.categories | first }}</span>
      {% endif %}
      <span>{% if post_external and post.redirect contains 'medium.com' %}Medium · {% endif %}{{ read_time }} min read</span>
      {% if post.tags and post.tags.size > 0 %}
        <span class="entry-tags">
          {% for tag in post.tags limit: 3 %}
            <a class="chip" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </div>
</article>
